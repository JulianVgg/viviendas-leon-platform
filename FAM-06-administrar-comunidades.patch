+import { Router } from 'express'
+import { Prisma } from '../../generated/prisma/client.js'
+import { requireAuth } from '../auth/auth.middleware.js'
+import { requirePermission } from '../auth/require-permission.middleware.js'
+import { createCommunity, updateCommunity, changeCommunityState, listCommunitiesForAdmin, CommunityError } from './communities.service.js'
+import { parseCommunityId, validateCommunityInput, validateCommunityState } from './communities.validation.js'
+
+export const adminCommunitiesRouter = Router()
+
+function handleError(error: unknown, res: import('express').Response, next: import('express').NextFunction) {
+  if (error instanceof CommunityError) {
+    res.status(error.status).json({ error: { code: error.code, message: error.message, details: error.details } })
+    return
+  }
+  if (error instanceof Prisma.PrismaClientKnownRequestError && error.code === 'P2002') {
+    res.status(409).json({ error: { code: 'DUPLICATE_COMMUNITY', message: 'La comunidad ya existe en el municipio.' } })
+    return
+  }
+  next(error)
+}
+
+function requestId(raw: unknown): number | null {
+  return parseCommunityId(raw)
+}
+
+adminCommunitiesRouter.get('/administracion', requireAuth, requirePermission('PANTALLA_COMUNIDADES'), async (_req, res, next) => {
+  try {
+    res.json({ data: await listCommunitiesForAdmin() })
+  } catch (error) { next(error) }
+})
+
+adminCommunitiesRouter.post('/', requireAuth, requirePermission('COMUNIDADES_WRITE'), async (req, res, next) => {
+  const validation = validateCommunityInput(req.body)
+  if (!validation.data) {
+    res.status(400).json({ error: { code: 'VALIDATION_ERROR', message: 'Revisa los datos de la comunidad.', details: validation.details } })
+    return
+  }
+  try {
+    const created = await createCommunity(validation.data, req.session.userId!)
+    res.status(201).location(`/api/v1/comunidades/administracion`).json({ data: created })
+  } catch (error) { handleError(error, res, next) }
+})
+
+adminCommunitiesRouter.patch('/:id/estado', requireAuth, requirePermission('COMUNIDADES_WRITE'), async (req, res, next) => {
+  const id = requestId(req.params.id)
+  if (!id) {
+    res.status(400).json({ error: { code: 'VALIDATION_ERROR', message: 'El identificador no es válido.' } })
+    return
+  }
+  const validation = validateCommunityState(req.body)
+  if (!validation.data) {
+    res.status(400).json({ error: { code: 'VALIDATION_ERROR', message: 'Revisa el estado de la comunidad.', details: validation.details } })
+    return
+  }
+  try {
+    res.json({ data: await changeCommunityState(id, validation.data.activo, req.session.userId!) })
+  } catch (error) { handleError(error, res, next) }
+})
+
+adminCommunitiesRouter.patch('/:id', requireAuth, requirePermission('COMUNIDADES_WRITE'), async (req, res, next) => {
+  const id = requestId(req.params.id)
+  if (!id) {
+    res.status(400).json({ error: { code: 'VALIDATION_ERROR', message: 'El identificador no es válido.' } })
+    return
+  }
+  const validation = validateCommunityInput(req.body)
+  if (!validation.data) {
+    res.status(400).json({ error: { code: 'VALIDATION_ERROR', message: 'Revisa los datos de la comunidad.', details: validation.details } })
+    return
+  }
+  try {
+    res.json({ data: await updateCommunity(id, validation.data, req.session.userId!) })
+  } catch (error) { handleError(error, res, next) }
+})
diff --git a/apps/api/src/modules/catalogs/communities.service.ts b/apps/api/src/modules/catalogs/communities.service.ts
new file mode 100644
--- /dev/null
+++ b/apps/api/src/modules/catalogs/communities.service.ts
@@ -0,0 +1,143 @@
+import { getPrismaClient } from '../../config/prisma.js'
+import type { Prisma } from '../../generated/prisma/client.js'
+import type { CommunityInput, FieldError } from './communities.validation.js'
+
+export class CommunityError extends Error {
+  constructor(
+    public readonly status: 400 | 404 | 409,
+    public readonly code: string,
+    message: string,
+    public readonly details: FieldError[] = [],
+  ) {
+    super(message)
+  }
+}
+
+function notFound(): never {
+  throw new CommunityError(404, 'COMMUNITY_NOT_FOUND', 'La comunidad solicitada no existe.')
+}
+
+// Bloquea el municipio para serializar altas y cambios de nombre dentro del mismo
+// territorio. Así también se impide que se desactive durante la validación.
+async function requireActiveMunicipality(tx: Prisma.TransactionClient, municipioId: number) {
+  const rows = await tx.$queryRaw<Array<{ id: number }>>`
+    SELECT id FROM municipio WHERE id = ${municipioId} AND activo = true FOR UPDATE
+  `
+  if (!rows.length) {
+    throw new CommunityError(400, 'INVALID_MUNICIPALITY', 'El municipio debe existir y estar activo.', [
+      { field: 'municipioId', message: 'Selecciona un municipio activo.' },
+    ])
+  }
+}
+
+async function ensureUniqueName(tx: Prisma.TransactionClient, data: CommunityInput, exceptId?: number) {
+  const duplicate = await tx.comunidad.findFirst({
+    where: {
+      municipioId: data.municipioId,
+      nombre: { equals: data.nombre, mode: 'insensitive' },
+      ...(exceptId ? { id: { not: exceptId } } : {}),
+    },
+    select: { id: true },
+  })
+  if (duplicate) {
+    throw new CommunityError(409, 'DUPLICATE_COMMUNITY', 'Ya existe una comunidad con este nombre en el municipio.', [
+      { field: 'nombre', message: 'Utiliza un nombre diferente.' },
+    ])
+  }
+}
+
+const selectCommunity = {
+  id: true,
+  nombre: true,
+  activo: true,
+  municipio: { select: { id: true, nombre: true, activo: true } },
+  _count: { select: { familias: true, capacitaciones: true } },
+} satisfies Prisma.ComunidadSelect
+
+function formatCommunity(record: Prisma.ComunidadGetPayload<{ select: typeof selectCommunity }>) {
+  const { _count, ...rest } = record
+  return { ...rest, familiasCount: _count.familias, capacitacionesCount: _count.capacitaciones }
+}
+
+export async function listCommunitiesForAdmin() {
+  const records = await getPrismaClient().comunidad.findMany({
+    orderBy: [{ municipio: { nombre: 'asc' } }, { nombre: 'asc' }, { id: 'asc' }],
+    select: selectCommunity,
+  })
+  return records.map(formatCommunity)
+}
+
+export async function createCommunity(data: CommunityInput, userId: number) {
+  return getPrismaClient().$transaction(async (tx) => {
+    await requireActiveMunicipality(tx, data.municipioId)
+    await ensureUniqueName(tx, data)
+    const created = await tx.comunidad.create({
+      data: { ...data, activo: true },
+      select: selectCommunity,
+    })
+    await tx.bitacora.create({ data: {
+      usuarioId: userId,
+      entidad: 'comunidad',
+      registroId: String(created.id),
+      accion: 'CREATE',
+      fecha: new Date(),
+      datosNuevos: JSON.stringify(data),
+      descripcion: 'Registro de comunidad.',
+    } })
+    return formatCommunity(created)
+  })
+}
+
+export async function updateCommunity(id: number, data: CommunityInput, userId: number) {
+  return getPrismaClient().$transaction(async (tx) => {
+    const existing = await tx.$queryRaw<Array<{ id: number; nombre: string; municipio_id: number; activo: boolean }>>`
+      SELECT id, nombre, municipio_id, activo FROM comunidad WHERE id = ${id} FOR UPDATE
+    `
+    if (!existing.length) return notFound()
+    await requireActiveMunicipality(tx, data.municipioId)
+    await ensureUniqueName(tx, data, id)
+    const updated = await tx.comunidad.update({ where: { id }, data, select: selectCommunity })
+    await tx.bitacora.create({ data: {
+      usuarioId: userId,
+      entidad: 'comunidad',
+      registroId: String(id),
+      accion: 'UPDATE',
+      fecha: new Date(),
+      datosAnteriores: JSON.stringify(existing[0]),
+      datosNuevos: JSON.stringify(data),
+      descripcion: 'Actualización de comunidad.',
+    } })
+    return formatCommunity(updated)
+  })
+}
+
+export async function changeCommunityState(id: number, activo: boolean, userId: number) {
+  return getPrismaClient().$transaction(async (tx) => {
+    const existing = await tx.$queryRaw<Array<{ id: number; municipio_id: number; activo: boolean }>>`
+      SELECT id, municipio_id, activo FROM comunidad WHERE id = ${id} FOR UPDATE
+    `
+    if (!existing.length) return notFound()
+    if (activo) await requireActiveMunicipality(tx, existing[0].municipio_id)
+    if (!activo && existing[0].activo) {
+      const activeFamilies = await tx.familia.count({ where: { comunidadId: id, estado: 'ACTIVA' } })
+      if (activeFamilies > 0) {
+        throw new CommunityError(409, 'COMMUNITY_HAS_ACTIVE_FAMILIES', 'La comunidad tiene familias activas. Reasígnalas antes de desactivarla.')
+      }
+    }
+    if (existing[0].activo === activo) {
+      return formatCommunity(await tx.comunidad.findUniqueOrThrow({ where: { id }, select: selectCommunity }))
+    }
+    const updated = await tx.comunidad.update({ where: { id }, data: { activo }, select: selectCommunity })
+    await tx.bitacora.create({ data: {
+      usuarioId: userId,
+      entidad: 'comunidad',
+      registroId: String(id),
+      accion: activo ? 'ACTIVATE' : 'DEACTIVATE',
+      fecha: new Date(),
+      datosAnteriores: JSON.stringify({ activo: existing[0].activo }),
+      datosNuevos: JSON.stringify({ activo }),
+      descripcion: 'Cambio de estado de comunidad.',
+    } })
+    return formatCommunity(updated)
+  })
+}
diff --git a/apps/api/src/modules/catalogs/communities.validation.ts b/apps/api/src/modules/catalogs/communities.validation.ts
new file mode 100644
--- /dev/null
+++ b/apps/api/src/modules/catalogs/communities.validation.ts
@@ -0,0 +1,50 @@
+export type CommunityInput = { nombre: string; municipioId: number }
+export type FieldError = { field: string; message: string }
+
+const MAX_INTEGER = 2_147_483_647
+export const MAX_COMMUNITY_NAME = 120
+
+export function parseCommunityId(value: unknown): number | null {
+  if (typeof value !== 'string' || !/^[1-9]\d*$/.test(value)) return null
+  const id = Number(value)
+  return Number.isSafeInteger(id) && id <= MAX_INTEGER ? id : null
+}
+
+export function validateCommunityInput(body: unknown): { data?: CommunityInput; details: FieldError[] } {
+  if (!body || typeof body !== 'object' || Array.isArray(body)) {
+    return { details: [{ field: 'body', message: 'Se requiere un objeto con los datos de la comunidad.' }] }
+  }
+  const fields = body as Record<string, unknown>
+  const details: FieldError[] = []
+  for (const key of Object.keys(fields)) {
+    if (!['nombre', 'municipioId'].includes(key)) {
+      details.push({ field: key, message: 'Este campo no está permitido.' })
+    }
+  }
+  const nombre = typeof fields.nombre === 'string'
+    ? fields.nombre.normalize('NFC').trim().replace(/\s+/g, ' ')
+    : ''
+  if (!nombre || nombre.length > MAX_COMMUNITY_NAME || /[\u0000-\u001f\u007f]/.test(nombre)) {
+    details.push({ field: 'nombre', message: `Ingresa un nombre válido de hasta ${MAX_COMMUNITY_NAME} caracteres.` })
+  }
+  const municipioId = fields.municipioId
+  if (typeof municipioId !== 'number' || !Number.isSafeInteger(municipioId) || municipioId < 1 || municipioId > MAX_INTEGER) {
+    details.push({ field: 'municipioId', message: 'Selecciona un municipio válido.' })
+  }
+  return details.length ? { details } : { data: { nombre, municipioId: municipioId as number }, details }
+}
+
+export function validateCommunityState(body: unknown): { data?: { activo: boolean }; details: FieldError[] } {
+  if (!body || typeof body !== 'object' || Array.isArray(body)) {
+    return { details: [{ field: 'body', message: 'Se requiere el estado de la comunidad.' }] }
+  }
+  const fields = body as Record<string, unknown>
+  const details: FieldError[] = []
+  for (const key of Object.keys(fields)) {
+    if (key !== 'activo') details.push({ field: key, message: 'Este campo no está permitido.' })
+  }
+  if (typeof fields.activo !== 'boolean') {
+    details.push({ field: 'activo', message: 'El estado debe ser verdadero o falso.' })
+  }
+  return details.length ? { details } : { data: { activo: fields.activo as boolean }, details }
+}

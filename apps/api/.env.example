PORT=3000
CLIENT_URL=http://localhost:5173
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/viviendas_leon"
# Generate a separate secret for each environment; never commit real secrets.
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# NTF-11: cada entorno debe configurar su par de claves VAPID.
VAPID_PUBLIC_KEY=REPLACE_WITH_PUBLIC_VAPID_KEY
VAPID_PRIVATE_KEY=REPLACE_WITH_PRIVATE_VAPID_KEY
# Contacto VAPID opcional. En produccion, usar un mailto: o una URL institucional HTTPS.
# Si se omite, se utiliza la URL publica del repositorio como identificador.
# VAPID_SUBJECT=mailto:contacto@tu-dominio.example
